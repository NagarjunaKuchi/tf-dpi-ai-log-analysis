{
  "title": "DPI log analysis",
  "uid": "dpi-log-analysis",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus",
        "label": "Prometheus"
      }
    ]
  },
  "tags": [
    "dpi"
  ],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Analyses completed by outcome (per min)",
      "description": "FAILED/CRASHED should be near zero; INSUFFICIENT_EVIDENCE is a legitimate outcome.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(dpi_analysis_completed_total[5m]))*60",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Analysis duration (avg / max)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(dpi_analysis_duration_seconds_sum[5m]))/sum(rate(dpi_analysis_duration_seconds_count[5m]))",
          "legendFormat": "avg"
        },
        {
          "refId": "B",
          "expr": "max(dpi_analysis_duration_seconds_max)",
          "legendFormat": "max"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "LLM call latency by operation (avg)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (operation) (rate(dpi_llm_call_seconds_sum[5m]))/sum by (operation) (rate(dpi_llm_call_seconds_count[5m]))",
          "legendFormat": "{{operation}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "LLM call errors (per min)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (operation) (rate(dpi_llm_call_seconds_count{result=\"error\"}[5m]))*60",
          "legendFormat": "{{operation}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Evidence claims verified vs rejected (per min)",
      "description": "A rising rejected share means the model is making unsupported claims.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (result) (rate(dpi_evidence_claims_total[15m]))*60",
          "legendFormat": "{{result}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Retrieval latency by collection (avg)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (collection) (rate(dpi_retrieval_latency_seconds_sum[5m]))/sum by (collection) (rate(dpi_retrieval_latency_seconds_count[5m]))",
          "legendFormat": "{{collection}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Ingestion lag (s)",
      "description": "Age of the newest ingested log relative to now. NaN until the first successful run.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(dpi_ingestion_lag_seconds)",
          "legendFormat": "lag"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Logs ingested / masked (per min)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(dpi_ingestion_logs_ingested_total[5m]))*60",
          "legendFormat": "ingested"
        },
        {
          "refId": "B",
          "expr": "sum(rate(dpi_ingestion_logs_masked_total[5m]))*60",
          "legendFormat": "masked"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Ingestion failures (per min)",
      "description": "Any dead-lettered record needs investigation.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(dpi_ingestion_runs_failed_total[5m]))*60",
          "legendFormat": "runs failed"
        },
        {
          "refId": "B",
          "expr": "sum(rate(dpi_ingestion_dead_lettered_total[5m]))*60",
          "legendFormat": "dead-lettered"
        },
        {
          "refId": "C",
          "expr": "sum(rate(dpi_ingestion_retries_total[5m]))*60",
          "legendFormat": "retries"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Embedding latency & failures",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(dpi_embeddings_latency_seconds_sum[5m]))/sum(rate(dpi_embeddings_latency_seconds_count[5m]))",
          "legendFormat": "avg latency (s)"
        },
        {
          "refId": "B",
          "expr": "sum(rate(dpi_embeddings_failures_total[5m]))*60",
          "legendFormat": "failures/min"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Elasticsearch query latency (avg)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 40
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(dpi_elasticsearch_query_latency_seconds_sum[5m]))/sum(rate(dpi_elasticsearch_query_latency_seconds_count[5m]))",
          "legendFormat": "avg"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "JVM heap used / max",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 40
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(jvm_memory_used_bytes{area=\"heap\"})",
          "legendFormat": "used"
        },
        {
          "refId": "B",
          "expr": "sum(jvm_memory_max_bytes{area=\"heap\"})",
          "legendFormat": "max"
        }
      ]
    }
  ]
}