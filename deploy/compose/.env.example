# Copy to .env and fill in. Never commit .env.
POSTGRES_PASSWORD=change-me
# Bundled dev Keycloak (docker compose --profile keycloak up). Choose a strong admin password; it is only used for the bootstrap admin.
KEYCLOAK_ADMIN_PASSWORD=change-me-too
# KEYCLOAK_PORT=8180
# External OIDC provider instead (then do not use the keycloak profile): set the issuer exactly as it appears in the token's `iss`,
# and DPI_JWK_SET_URI to a key endpoint reachable from the container (set it empty to derive it from the issuer's discovery document).
# DPI_JWT_ISSUER_URI=https://idp.example.org/realms/dpi
# DPI_JWK_SET_URI=
# DPI_JWT_AUDIENCE=dpi-log-analysis
DPI_ES_URIS=https://elasticsearch.example.org:9200
DPI_ES_USER=
DPI_ES_PASSWORD=
DPI_ES_API_KEY=
DPI_CHAT_MODEL=llama3.1:8b
DPI_EMBEDDING_MODEL=bge-m3
