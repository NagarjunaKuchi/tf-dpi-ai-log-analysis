# cp terraform.tfvars.example terraform.tfvars   (terraform.tfvars is git-ignored; never commit secrets)
# Identity: by default a DEV-MODE Keycloak is started (realm "dpi"). To use your own OIDC provider instead:
# deploy_keycloak = false
# jwt_issuer_uri  = "https://idp.example.org/realms/dpi"   # exactly the token's `iss`
# jwk_set_uri     = ""                                      # optional; set when the issuer URL is not reachable from the container
es_uris        = "https://host.docker.internal:9200"
# es_username = ""
# es_password = ""
# es_api_key  = ""
chat_model      = "llama3.1:8b"   # or mistral:7b — verify the tag in your Ollama registry
embedding_model = "bge-m3"
# build_local_image = false
# app_image         = "<dockerhub-user>/dpi-log-analysis:latest"
# ollama_gpu        = true
